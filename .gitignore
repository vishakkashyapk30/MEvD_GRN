# Data (downloaded from SC-MO-GRN-DB; re-fetch with scripts/01_download_data.sh)
data/raw/
data/processed/
data/splits/

# Results / checkpoints / logs -- but DO track the small numeric-results JSONs
# (results/ablations/*.json, results/baselines/*.json): these are what every
# number in results.md/plan.md/paper/main.tex is supposed to be traceable to,
# and until now NOTHING under results/ was ever in git, so those citations
# were unreproducible from a fresh clone regardless of what happened to be on
# any one machine's disk. Checkpoints and logs stay ignored (large, regenerable).
# (Negation requires un-ignoring each parent dir explicitly -- git won't
# recurse into an ignored directory to apply a deeper negation.)
results/*
!results/ablations/
results/ablations/*
!results/ablations/*.json
!results/baselines/
results/baselines/*
!results/baselines/*.json
!results/transfer/
results/transfer/*
!results/transfer/*.json
!results/joint_training/
results/joint_training/*
!results/joint_training/*.json
!results/K562_results.json
!results/*_results.json
result_logs/
logs/
*.pt
*.npy

# Superseded local planning document
MEvD_GRN_plan.md

# Local-only status/TODO tracker (not part of committed documentation)
status.md

# Local presentation assets
mevd_grn_architecture.html
mevd_grn_architecture.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.venv/
env/

# OS
.DS_Store

# LaTeX build artifacts (paper/main.pdf and main.bbl are committed; the rest regenerates)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
